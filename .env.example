# =============================================================================
# Finance MCP: environment file
# 1. Copy:   cp .env.example .env
# 2. Fill in the values below (no quotes, no spaces around "=").
# 3. Lock it: chmod 600 .env
# .env is in .gitignore and .dockerignore: it never goes to git or into the image.
# =============================================================================

# ---- Pluggy (dashboard.pluggy.ai → Applications → your app → Credenciais) ----
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Comma-separated Item IDs, one per connected institution (Demo → Connected Items, or scripts/connect.py)
PLUGGY_ITEM_IDS=

# ---- Market data (brapi.dev → sign up → free token). Needed for most tickers. ----
BRAPI_TOKEN=

# ---- Public address of this server (the subdomain Caddy serves) ----
PUBLIC_BASE_URL=https://finance.joaokishimoto.dev

# ---- Login for claude.ai: "Sign in with GitHub" ----
# github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:               https://finance.joaokishimoto.dev
#   Authorization callback URL: https://finance.joaokishimoto.dev/auth/callback
AUTH_MODE=github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only these GitHub usernames can use the server (comma-separated)
ALLOWED_GITHUB_USERS=
# Random secret that signs login tokens. Generate with:  openssl rand -hex 32
JWT_SIGNING_KEY=

# ---- Optional ----
# TZ=America/Sao_Paulo
